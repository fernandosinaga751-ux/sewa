# URL website produksi (tanpa garis miring di akhir)
NEXT_PUBLIC_SITE_URL=https://www.domainanda.com
# Alamat rahasia dashboard admin, huruf kecil/angka/strip saja, TANPA titik. Contoh: ruang-x7k2q9
ADMIN_PATH=ganti-dengan-alamat-rahasia-anda
# Kode verifikasi Google Search Console (opsional)
NEXT_PUBLIC_GSC_VERIFICATION=
# Dari Firebase Console > Project settings > Your apps (Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
