rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ganti GANTI_UID_ADMIN dengan UID user admin dari Firebase Authentication
    function isAdmin() { return request.auth != null && request.auth.uid == 'GANTI_UID_ADMIN'; }
    match /{col}/{id} {
      allow read: if col in ['cars', 'posts', 'settings'];
      allow write: if isAdmin() && col in ['cars', 'posts', 'settings'];
    }
  }
}
